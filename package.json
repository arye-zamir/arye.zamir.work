{
  "name": "arye.zamir.work",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "security": "pnpm audit --prod --audit-level low && pnpm audit --audit-level high",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.11.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
